{
  "name": "vera-agent",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {},
  "bin": {
    "vera": "./dist/cli.js"
  },
  "vera": {
    "managedRuntimeHostUpdateCompatibility": 1
  },
  "scripts": {
    "clean": "node ../scripts/clean-paths.mjs dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json && node scripts/chmod-bin.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm --workspace @vera/core run build && npm --workspace @vera/storage run build && npm --workspace @vera/mcp run build && npm --workspace @vera/runtime run build && npm --workspace @vera/runtime-host run build && npm --workspace @vera/eval run build",
    "test": "npm run clean && npm run build && npm run test:dist",
    "test:dist": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@earendil-works/pi-tui": "0.84.2",
    "@vera/core": "1.0.0",
    "@vera/eval": "1.0.0",
    "@vera/mcp": "1.0.0",
    "@vera/runtime": "1.0.0",
    "@vera/runtime-host": "1.0.0",
    "@vera/storage": "1.0.0"
  }
}
